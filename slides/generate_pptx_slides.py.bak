# ==============================================================================
# MAIN EXPORT ROUTINE
# ==============================================================================
def generate_all_decks():
    output_dir = Path("slides")
    output_dir.mkdir(parents=True, exist_ok=True)

    # 1. Master Deck (All Labs)
    master_prs = create_deck()
    build_title_slide(master_prs)
    build_roadmap_slide(master_prs)
    build_lab00_slides(master_prs)
    build_lab01_slides(master_prs)
    build_lab02_slides(master_prs)
    build_lab03_slides(master_prs)
    build_lab04_slides(master_prs)
    build_lab05_slides(master_prs)
    build_lab06_slides(master_prs)
    build_lab07_slides(master_prs)
    build_lab08_slides(master_prs)
    build_summary_slide(master_prs)

    master_path = output_dir / "Hardware_AI_Acceleration_Master_Slides.pptx"
    master_prs.save(str(master_path))
    print(f"✅ Generated Master Presentation: {master_path}")

    root_master_path = Path("Hardware_AI_Acceleration_Master_Slides.pptx")
    master_prs.save(str(root_master_path))
    print(f"✅ Saved Root Copy: {root_master_path}")

    # 2. Individual Lab Decks
    lab_generators = [
        ("Lab00_Signed_Adder_Saturation.pptx", build_lab00_slides),
        ("Lab01_INT8_Multiplier.pptx", build_lab01_slides),
        ("Lab02_MAC_Unit.pptx", build_lab02_slides),
        ("Lab03_Weight_Stationary_PE.pptx", build_lab03_slides),
        ("Lab04_Systolic_Matrix_Multiplier.pptx", build_lab04_slides),
        ("Lab05_Hardware_Square_Root.pptx", build_lab05_slides),
        ("Lab06_Safe_Softmax.pptx", build_lab06_slides),
        ("Lab07_Reciprocal_Square_Root_rsqrt.pptx", build_lab07_slides),
        ("Lab08_Exponential_SFU.pptx", build_lab08_slides),
    ]

    for filename, build_fn in lab_generators:
        prs = create_deck()
        build_title_slide(prs)
        build_fn(prs)
        build_summary_slide(prs)
        deck_path = output_dir / filename
        prs.save(str(deck_path))
        print(f"✅ Generated Individual Deck: {deck_path}")

if __name__ == "__main__":
    generate_all_decks()
